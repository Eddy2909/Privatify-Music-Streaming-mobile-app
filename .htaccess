Options -Indexes
DirectoryIndex index.php

# --- Zugriffsschutz ---------------------------------------------------------
# Auf Hosts, deren AllowOverride kein AuthConfig erlaubt, wird ein "Require"
# still ignoriert. Deshalb zusaetzlich ueber mod_rewrite (Klasse FileInfo, wie
# Header) sperren - das funktioniert dort zuverlaessig.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) Versteckte Dateien/Ordner (.user.ini, .htaccess, .git, ...); .well-known bleibt frei
    RewriteRule (^|/)\.(?!well-known/) - [F]

    # 2) Sensible Dateitypen
    RewriteRule \.(sql|md|ini|log|bak|orig|conf)$ - [F,NC]

    # 3) Interne Anwendungsordner und Datenverzeichnis
    RewriteRule ^(app|config|storage)(/|$) - [F,NC]
</IfModule>

# Fallback, falls mod_rewrite fehlt
<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 403 (^|/)\.(?!well-known/)
        RedirectMatch 403 (?i)\.(sql|md|ini|log|bak|orig|conf)$
        RedirectMatch 403 (?i)^/(app|config|storage)/
    </IfModule>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^(schema\.sql|README.*|FULL_CODE.*|.*\.md|\.user\.ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
